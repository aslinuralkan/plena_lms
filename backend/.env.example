# Lokal geliştirme — gömülü PostgreSQL (.tools/pg) + disk depolama
# ./setup.sh bu dosyadan backend/.env üretir (AUTH_SECRET otomatik oluşturulur)
DATABASE_URL="postgresql://marti@localhost:5433/postgres?schema=public"
AUTH_SECRET="degistir-bunu-rastgele-uzun-bir-deger-yap"
PLATFORM_AUTH_SECRET="normal-oturum-secretindan-farkli-rastgele-bir-deger"
STORAGE_DRIVER=local
CORS_ALLOWED_ORIGINS=http://localhost:3002
APP_URL=http://localhost:3002
APP_TIMEZONE=Europe/Istanbul
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="Plena LMS <noreply@bislabs.tech>"

# İlk Platform Admin bootstrap (sabit/demo şifre kullanmayın)
# PLATFORM_ADMIN_EMAIL=platform-admin@example.com
# PLATFORM_ADMIN_NAME="Plena Super Admin"
# PLATFORM_ADMIN_PASSWORD="en-az-12-karakterli-guclu-sifre"

